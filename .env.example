# Copie para .env e preencha. NUNCA publique o arquivo .env.
NODE_ENV=production
PORT=3000
# Texto longo e aleatório (mínimo 24 caracteres). Ex.: gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Envio de e-mail pelo Resend (https://resend.com): chave e remetente de um domínio verificado
RESEND_API_KEY=
MAIL_FROM=Currículo IA <nao-responda@seudominio.com.br>
# E-mails com acesso à lista de contatos (separados por vírgula)
ADMIN_EMAILS=seu@email.com
# Onde fica o banco de dados (use um disco persistente da hospedagem)
DB_PATH=./data/app.db
# Use 1 se o site ficar atrás de proxy da hospedagem (Railway, Render, Fly, Nginx)
TRUST_PROXY=1
# Opcional: endereço oficial do site, ex.: https://curriculoia.com.br
ORIGIN=

# --- Pagamento por Pix (Mercado Pago) ---
# Access Token da sua aplicação no painel de desenvolvedores do Mercado Pago. É SECRETO: nunca no site, nunca no chat.
# Comece com a credencial de TESTE; troque pela de produção só depois de testar.
MP_ACCESS_TOKEN=
# Endereço público do site (sem barra no final). O Mercado Pago avisa os pagamentos em BASE_URL/api/pay/webhook
BASE_URL=https://seudominio.com.br
# Preço em centavos (1000 = R$ 10,00). Para o primeiro teste real, use 100 (R$ 1,00).
PRICE_CENTS=1000

# --- Dados que aparecem na Política de Privacidade e nos Termos de Uso ---
# Nome de quem opera o site (seu nome completo ou a razão social) e e-mail de contato para pedidos de privacidade
LEGAL_NAME=
CONTACT_EMAIL=
# Opcional: CPF/CNPJ que aparecerá ao lado do nome
LEGAL_DOC=
